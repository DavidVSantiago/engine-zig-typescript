{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bun Test (Arquivo Aberto)",
            "type": "bun",
            "request": "launch",
            "program": "${file}",
            "runtimeArgs": [
                "test"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Bun Test (Todos os Testes)",
            "type": "bun",
            "request": "launch",
            "program": "test",
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Bun Test (Sem Extensão / JavaScript Debugger)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "bun",
            "runtimeArgs": [
                "test"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug Zig Tests (Parar no Breakpoint)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/test",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "expressions": "simple",
            "initCommands": [
                "settings set target.language c++"
            ],
            "preLaunchTask": "Zig: Build Test (Debug)"
        },
        {
            "name": "Debug Zig Tests (Escolher Teste por Filtro)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/test",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "expressions": "simple",
            "initCommands": [
                "settings set target.language c++"
            ],
            "preLaunchTask": "Zig: Build Test (Filtered)"
        }
    ]
}
